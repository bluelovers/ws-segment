  "bugs": {
    "url": "https://github.com/bluelovers/ws-segment/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-segment.git",
    "directory": "packages/segment-dict"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "test": "echo pnpm run test:jest && pnpm run test:segment",
    "test:jest": "jest",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:segment": "echo pnpm --filter novel-segment run test",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test && pnpm run sort:all",
    "version": "git commit -m \"chore(dict): save dict before new version\" ./dict ./test/sort.ts & echo version",
    "prepublishOnly": "echo prepublishOnly",
    "postpublish": "pnpm run postpublishOnly:add",
    "postpublish2": "lerna run --stream --scope novel-segment postpublish2 && lerna run --scope @novel-segment/api-server now-deploy",
    "postpublish:after": "node ./script/publish-after",
    "postpublish:done": "pnpm run postpublish:after",
    "postpublishOnly:add": "pnpm -w run postpublishOnly:add segment-dict novel-segment @novel-segment/api-server",
    "ncu": "yarn-tool ncu -u",
    "sort:all": "pnpm run sort:all:before && pnpm run sort:list:synonym & pnpm run sort:dict:synonym & pnpm run sort:line",
    "sort:all:before": "git commit -m \"chore(dict): save dict before sort:all\" ./dict & echo \"sort:all:before\"",
    "sort:dict:synonym": "tsx ./script/sort.dict_synonym.ts",
    "sort:line": "tsx ./script/sort-line.ts",
    "sort:list:synonym": "tsx ./script/sort_list_synonym.ts",
    "sort-package-json": "yarn-tool sort",
    "task:do-split": "pnpm run task:do-split:commit && ts-node ./test/sort.ts",
    "task:do-split:commit": "git commit -m \"chore(dict): save dict before split\" ./dict & echo \"save dict\"",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/fast-glob": "^3.0.4",
    "@bluelovers/string-natural-compare": "^2.0.15",
    "@novel-segment/dict-loader-core": "^1.0.32",
    "@novel-segment/loader-line": "^1.0.35",
    "@novel-segment/loader-stopword": "^1.0.33",
    "@novel-segment/loaders": "^1.0.55",
    "@novel-segment/stream-loader-core": "^1.0.31",
    "@novel-segment/util": "^1.0.80",
    "@novel-segment/util-compare": "^1.0.28",
    "bluebird": "^3.7.2",
    "core-decorators": "^0.20.0",
    "crlf-normalize": "^1.0.20",
    "tslib": ">=2"
  },
  "devDependencies": {
    "@novel-segment/sort-dict-table": "^1.0.31",
    "@novel-segment/sort-synonym": "^1.0.27"
  },
  "gitHead": "b53ee34cb7a1abaf060f872ed0030effdc50e1ec"
}

{
  "name": "@novel-segment/api-server",
  "version": "1.0.82",
  "private": true,
  "description": "simple segment api server",
  "homepage": "https://github.com/bluelovers/ws-segment/tree/master/packages/@novel-segment/api-server#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-segment/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-segment.git",
    "directory": "packages/@novel-segment/api-server"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "coverage": "nyc npm run test",
    "lint": "eslint **/*.ts",
    "test": "node --run test:jest --",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "preversion": "pnpm run test",
    "version": "echo version",
    "postpublish_": "git commit -m \"publish new version\" .",
    "postpublish:commit": "tsx ./script/publish-after2.ts",
    "postpublish:done": "pnpm run now-deploy",
    "ncu": "yarn-tool ncu -u",
    "now-build": "pnpm run now-build:install && pnpm run now-build:run",
    "now-build:install": "yarn add novel-segment vercel",
    "now-build:run": "node ./build.js",
    "now-deploy": "pnpm run now-build:run && ynpx vercel deploy",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-cjk/zh-convert": "^1.0.58",
    "cors": "^2.8.6",
    "crlf-normalize": "^1.0.20",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "tslib": ">=2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "*"
  },
  "peerDependencies": {
    "novel-segment": "^2.7.121",
    "vercel": "<38 >=37.14.0"
  },
  "engines": {
    "node": ">=10"
  }
}

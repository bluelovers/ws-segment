  ],
  "homepage": "https://github.com/bluelovers/ws-segment#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-segment/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-segment.git"
  },
  "license": "ISC",
  "author": "",
  "directories": {
    "test": "test"
  },
  "workspaces": [
    "packages/@novel-segment/*",
    "packages/*"
  ],
  "scripts": {
    "review:all": "yarn-tool ws run review --concurrency 1",
    "review:since": "pnpm run review:all --since",
    "coverage:all": "yarn-tool ws run coverage --concurrency 1",
    "coverage:since": "pnpm run coverage:all --since",
    "lint:all": "yarn-tool ws run lint --concurrency 1",
    "lint:since": "pnpm run lint:all --since",
    "pretest": "echo pretest",
    "test": "pnpm --filter novel-segment run test-ts",
    "test:all": "yarn-tool ws run test --concurrency 1",
    "test:jest:clearCache": "jest --clearCache",
    "test:local-demo-cache": "pnpm --filter novel-segment run local-demo-cache",
    "test:local-demo-lazy": "pnpm --filter novel-segment run local-demo-lazy",
    "test:since": "pnpm run test:all --since",
    "test:snapshot:all": "yarn-tool ws run test:snapshot --concurrency 1",
    "test:snapshot:since": "pnpm run test:snapshot:all --since",
    "test:tsd:all": "yarn-tool ws run test:tsd --concurrency 1",
    "test:tsd:since": "pnpm run test:tsd:all --since",
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:reset-lockfile": "yarn-tool install --reset-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build:all": "yarn-tool ws run build --concurrency 1",
    "build:since": "pnpm run build:all --since",
    "ci:install": "pnpm add --save-build -w lerna yarn-tool ts-node typescript ynpx tsx",
    "ci:install:pnpm": "pnpm install --frozen-lockfile && pnpm add --workspace yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:install:yarn": "yarn install --frozen-lockfile && yarn add -W yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:build": "pnpm run ci:build:script && pnpm run ci:build:commit",
    "ci:build:commit": "tsx ./script/run/ci-build.ts",
    "ci:build:script": "pnpm --filter novel-segment run local-demo-cache",
    "lerna:publish": "pnpm run prepublishOnly:root && lerna publish && pnpm run postpublishOnly",
    "lerna:publish:yes": "pnpm run prepublishOnly:check-bin && pnpm run preversion:segment && lerna publish --yes --bump patch --ignore-changes @novel-segment/api-server --loglevel silly && pnpm run postpublishOnly",
    "lerna:publish:yes:force": "lerna publish --no-private --yes --bump patch --force-publish",
    "lerna:publish:yes:major": "node --run prepublishOnly:root && lerna publish --no-private --yes --bump major && pnpm run postpublishOnly",
    "lerna:publish:yes:minor": "node --run prepublishOnly:root && lerna publish --no-private --yes --bump minor && pnpm run postpublishOnly",
    "lerna:publish:yes:patch": "node --run prepublishOnly:root && lerna publish --no-private --yes --bump patch && pnpm run postpublishOnly",
    "ws:fix-all": "yarn-tool fix-all --overwriteHostedGitInfo",
    "ws:fix-all:resetStaticFiles": "node --run ws:fix-all -- --resetStaticFiles",
    "preversion": "pnpm run test",
    "preversion:segment": "tsx ./script/run/ws-prepublish.ts",
    "version": "echo version",
    "postversion": "yarn-tool fix-all",
    "prepublish": "echo prepublish",
    "prepublish:fix-links": "echo skip fix-ws-links (yarn-only)",
    "prepublish:lockfile": "sync-lockfile .",
    "prepare": "echo prepare",
    "prepare:fix-ws-links": "echo skip fix-ws-links (yarn-only)",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:lockfile": "ynpx --quiet sync-lockfile",
    "prepublishOnly:root": "pnpm run prepublishOnly:check-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublish:git:subtree": "node --run postpublish:git:subtree:core & echo postpublish:git:subtree",
    "postpublish:git:subtree:core": "git subtree push novel-segment-cli master --prefix packages/novel-segment-cli && git subtree push node-segment master --prefix packages/novel-segment && git subtree push node-segment-dict master --prefix packages/segment-dict",
    "postpublish:now-deploy": "tsx ./script/run/postpublish-now-deploy.ts",
    "postpublish:segment": "tsx ./script/run/postpublish-segment.ts",
    "postpublish:subtree": "tsx ./script/run/postpublish-subtree.ts",
    "postpublishOnly": "pnpm run postpublish:segment & git push && pnpm run postpublish:now-deploy && pnpm run postpublish:subtree",
    "postpublishOnly:ws-root-changelog": "ynpx ws-root-changelog & git add ./CHANGELOG.md & git commit ./CHANGELOG.md -m \"chore(changelog): update changelog toc in workspaces root\" & echo update changelog toc in workspaces root",
    "postpublishOnly:add": "tsx ./script/run/postpublish-add.ts",
    "ncu": "pnpm run ncu:ws",
    "ncu:ws": "yarn-tool ncu -u --AA",
    "ncu:root": "yarn-tool ncu -u",
    "sort-package-json": "pnpm run sort-package-json:root && pnpm run sort-package-json:ws",
    "sort-package-json:root": "yarn-tool sort",
    "sort-package-json:ws": "yarn-tool ws sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "resolutions": {},
  "dependencies": {
    "@git-lazy/debug": "^2.0.3",
    "@git-lazy/subtree": "^2.0.3",
    "@lazy-cjk/zh-table-list": "^1.0.94",
    "@lazy-num/sum": "^1.0.10",
    "@lazy-random/fake-lib-r-math-rng": "^1.0.10",
    "@lazy-random/preset-seedrandom": "^1.0.11",
    "@lazy-random/simple-wrap": "^1.0.10",
    "@lazy-random/util-distributions": "^1.0.10",
    "@lazy-random/util-probabilities": "^1.0.10",
    "@lazy-random/util-test": "^1.0.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@novel-segment/pretty-diff": "^1.0.28",
    "@yarn-tool/find-deps": "^3.0.11",
    "@yarn-tool/ws-changed": "^3.0.11",
    "array-hyper-unique": "^2.1.8",
    "bluebird": "^3.7.2",
    "chai": "<5 >=4.3.10",
    "chai-asserttype-extra": "^2.0.14",
    "chai-string": "^1.6.0",
    "cjk-conv": "^1.2.153",
    "cross-spawn-extra": "^3.0.3",
    "debug-color2": "^1.3.2",
    "diff": "^9.0.0",
    "fs-extra": "^11.4.0",
    "git-root2": "^2.0.3",
    "jest": "^30.5.1",
    "n-readlines": "^3.4.1",
    "prettyuse": "^0.0.0",
    "random-extra": "^5.0.2",
    "regexp-cjk": "^3.3.120",
    "str-util": "^3.0.2",
    "string-natural-compare": "^3.0.1",
    "transliteration": "^2.6.1",
    "ts-jest": "^29.4.12",
    "uni-string": "^2.0.7",
    "upath2": "^3.1.25",
    "ws-pkg-list": "^3.0.11"
  },
  "devDependencies": {
    "@bluelovers/fast-glob": "^3.0.4",
    "@bluelovers/jest-config": "^1.1.11",
    "@bluelovers/tsconfig": "^2.0.3",
    "@git-lazy/diff-staged": "^2.0.3",
    "@git-lazy/util": "^2.0.3",
    "@types/benchmark": "^2.1.5",
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^5.2.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.0",
    "@types/transliteration": "^1.6.6",
    "@types/yargs": "^17.0.35",
    "@yarn-tool/require-resolve": "*",
    "@yarn-tool/ws-find-up-paths": "^1.0.22",
    "undici-types": "^8.10.2"
  }
}
